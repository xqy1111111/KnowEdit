## Copy this file to `.env` and fill in your credentials.
## Lines starting with `#` are comments and can be removed.

# Required: API key for the large language model provider.
OPENAI_API_KEY=sk-your-key

# Optional: override the HTTP endpoint if you are using a proxy or Azure/OpenAI-compatible service.
# Leave commented to use https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Default model to use for generating CoT rationales.
OPENAI_MODEL=gpt-4.1

# Optional generation defaults.
# REQUEST_TIMEOUT=60
# REQUEST_MAX_RETRIES=5
